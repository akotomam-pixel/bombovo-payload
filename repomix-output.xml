      )}

      <div className="grid grid-cols-2 gap-4 mb-4">
        <div className="bg-white rounded-3xl p-6 shadow-sm">
          <h3 className="text-sm font-semibold text-gray-500 mb-4">Odkiaľ prišli (referrer)</h3>
