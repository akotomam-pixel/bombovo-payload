        throw new Error('Server error')
      }

      setSubmitSuccess(true)
      window.scrollTo({ top: 0, behavior: 'smooth' })
      setFormData({
        teacherName: '',
        schoolAddress: '',
        phone: '',
        email: '',
        numberOfPeople: '',
        note: ''
      })
