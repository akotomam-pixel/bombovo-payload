                {/* Yellow underline */}
                <svg
                  className="absolute left-0 -bottom-2 w-full"
                  viewBox="0 0 200 12"
                  preserveAspectRatio="none"
                  style={{ height: '12px' }}
                >
                  <path
                    d="M 0 8 Q 25 2, 50 6 T 100 6 T 150 6 T 200 8"
                    stroke="#FDCA40"
                    strokeWidth="3"
                    fill="none"
                    strokeLinecap="round"
                  />
                  <path
                    d="M 0 9 Q 30 4, 60 7 T 120 7 T 180 9"
                    stroke="#FDCA40"
                    strokeWidth="2.5"
                    fill="none"
                    strokeLinecap="round"
                    opacity="0.7"
                  />
                </svg>
              </span>
