                    <span className="text-left text-base md:text-lg font-semibold text-bombovo-dark pr-4">
                      {faq.question}
                    </span>
                    <FaChevronDown 
                      className={`flex-shrink-0 text-bombovo-dark transition-transform duration-200 text-lg md:text-xl ${
                        isOpen ? 'rotate-180' : ''
                      }`}
                    />
