          {/* Cena with red underline */}
          <div className="mb-8">
            <p className="text-2xl font-bold text-bombovo-dark relative inline-block">
              Cena: 30€
              <span className="absolute left-0 -bottom-1 w-full h-1 bg-bombovo-red"></span>
            </p>
          </div>
          
          {/* Button to scroll to form */}
          <div className="mb-8">
