                    className="absolute top-full mt-2 w-full bg-white rounded-2xl shadow-xl z-10 max-h-80 overflow-y-auto"
                    initial={{ opacity: 0, y: -10 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ duration: 0.2 }}
