                    </label>
                    <input
                      type="email"
                      name="email"
                      value={formData.email}
                      onChange={handleInputChange}
                      className={fieldClass('email')}
                    />
                    {isFieldError('email') && <p className="mt-1 text-sm text-red-500">Toto pole je povinné</p>}
                  </div>
                </div>

